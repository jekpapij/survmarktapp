# Template `supabase/.env` — COPY file ini jadi `supabase/.env` (git-ignored,
# lihat `supabase/.gitignore`) dan isi nilai ASLI di sana. JANGAN edit file
# INI dengan nilai asli — file ini yang di-commit ke Git per rubrik CPMK 6
# ("Template Environment Variables, No Secrets").
#
# Cara dapetin tiap nilai — lihat CLAUDE.md checklist "CPMK 5 — Payment
# Gateway Midtrans via Supabase" bagian B (Service Account Firebase) & E
# (Midtrans Sandbox).

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxxxxxxxxxxxxxxxxxxxxxxx\n-----END PRIVATE KEY-----\n"
MIDTRANS_SERVER_KEY=Mid-server-xxxxxxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=Mid-client-xxxxxxxxxxxxxxxxxxxxxxxx
