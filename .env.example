# Template variabel environment SurvMarkt — SEMUA nilai di bawah CONTOH/
# PLACEHOLDER, aman di-commit (rubrik CPMK 6, Section V: ".env.example —
# Template Environment Variables, No Secrets"). Nilai ASLI-nya nggak pernah
# ada di 1 file `.env` doang (Flutter `String.fromEnvironment`/
# `bool.fromEnvironment` baca dari compile-time --dart-define, BUKAN dari
# file runtime) — didaftarin di sini biar tetap ke-dokumentasiin di 1
# tempat sesuai format wajib rubrik.

# --- Dart-define flags, dipass manual tiap `flutter run`/`flutter build` ---
# Contoh: flutter run --dart-define=USE_FIREBASE_BACKEND=true --dart-define=...

# Aktifin backend Firebase+Supabase beneran (Auth+Wallet, CPMK 5). false = Mock.
USE_FIREBASE_BACKEND=true
# Nonaktifin data dummy in-memory — SELALU dipasangin bareng USE_FIREBASE_BACKEND.
USE_MOCK_BACKEND=false
# URL Supabase Edge Functions (Payment Gateway Midtrans) — dari `supabase
# link`/dashboard project lo sendiri, formatnya:
# https://<project-ref>.supabase.co/functions/v1
SUPABASE_FUNCTIONS_URL=https://your-project-ref.supabase.co/functions/v1
# Base URL REST API custom lama — jalur mati/nggak kepake lagi sejak pindah
# ke Firebase+Supabase, dibiarin buat referensi/kompatibilitas mundur.
API_BASE_URL=http://10.0.2.2:3000/api/v1

# --- File config sensitif LAIN (bukan .env, taruh manual per lokasi — lihat
#     template masing-masing, SEMUA git-ignored) ---
# android/app/google-services.json  — Firebase Console > Project settings > download
# android/key.properties            — lihat android/key.properties.example
# supabase/.env                     — lihat supabase/.env.example
